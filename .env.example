# Supabase 연결 정보. 이 파일을 복사해 .env 로 만들고 값을 채우세요.
#   Windows: copy .env.example .env
# .env 는 .gitignore에 있어 커밋되지 않습니다. service_role 키는 절대 커밋/공유 금지.

# Settings → Data API 의 Project URL (공개 가능)
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Settings → API Keys 의 secret(=service_role) 키 — 쓰기 전용, 절대 노출 금지
SUPABASE_SERVICE_KEY=

# publishable(=anon) 키 — 대시보드 읽기용, 공개 가능
SUPABASE_ANON_KEY=
